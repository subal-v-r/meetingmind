# Groq API Key (Required for transcription and AI analysis)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# SQLite Database Location (created automatically on first startup)
DATABASE_URL=sqlite:///./meetingmind.db

# File Storage
UPLOAD_DIR=uploads

# CORS (Frontend origin - update for production)
FRONTEND_URL=http://localhost:5173

# Optional: Override default Groq models
# Available LLM models (check yours at https://api.groq.com/openai/v1/models):
#   openai/gpt-oss-20b       ← fast, free, recommended
#   openai/gpt-oss-120b      ← more capable, may have stricter limits
#   qwen/qwen3.6-27b         ← alternative free model
# GROQ_LLM_MODEL=openai/gpt-oss-20b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
